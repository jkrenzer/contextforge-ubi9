# Replace the image with a digest from a successful Actions build.
CONTEXTFORGE_IMAGE=ghcr.io/jkrenzer/contextforge-ubi9:stable-ubi9
CONTEXTFORGE_DATA_DIR=/volume1/docker/contextforge/data
CONTEXTFORGE_ORIGIN=https://mcp.example.com
PLATFORM_ADMIN_EMAIL=admin@example.com
# Generate each independently. For passwords ensure upper/lower/digit/special.
# For example: openssl rand -hex 32, then append Aa1! for password fields.
# Use single quotes in this file if a password contains a literal dollar sign.
JWT_SECRET_KEY=__REPLACE_ME__
AUTH_ENCRYPTION_SECRET=__REPLACE_ME__
PLATFORM_ADMIN_PASSWORD=__REPLACE_ME__
BASIC_AUTH_PASSWORD=__REPLACE_ME__
DEFAULT_USER_PASSWORD=__REPLACE_ME__
# Only internal MCP subnets and, if needed, the SSO server's LAN IP /32.
SSRF_ALLOWED_NETWORKS=[]
# Optional Synology SSO overlay values. Copy EXACT URLs from OIDC discovery.
SSO_CLIENT_ID=__REPLACE_ME__
SSO_CLIENT_SECRET=__REPLACE_ME__
SSO_ISSUER=https://nas.example.com/webman/sso
SSO_AUTHORIZATION_URL=https://nas.example.com/webman/sso/SSOOauth.cgi
SSO_TOKEN_URL=https://nas.example.com/webman/sso/SSOAccessToken.cgi
SSO_USERINFO_URL=https://nas.example.com/webman/sso/SSOUserInfo.cgi
SSO_JWKS_URI=https://nas.example.com/webman/sso/openid-jwks.json
